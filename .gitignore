# Local input and generated output for source runs
/Input/
/Output/
/Diagnostics/
/Recovery/
/History/
/shower_programmer_ui_settings.json
/manual_overrides.json
/processing_history.json
/shower_programmer.sqlite3*
/.shower_update.json
/Test Workspace/
/Rollback/
Configuration Backups/
.Network PDF Cache/
.__sp_new_*/
.__sp_old_*/

# Installed one-folder application and all of its local runtime state.
# The publishable one-folder build lives in release/Shower-Programmer-Windows.zip.
/Shower Programmer/

# Generated Python bytecode
__pycache__/
*.py[cod]
.pytest_cache/

# Generated build and temporary output
/build/
/tmp/
/tests/_verification/
/_verification/
/dist/
# Only reviewed sanitized regression fixtures belong here, not real order files.
/tests/known_orders/*
!/tests/known_orders/README.md
!/tests/known_orders/manifest.json
!/tests/known_orders/kinsdale_oos_001.json
!/tests/known_orders/legacy_process_list_sample.xls
/--self-test-output
/*-self-test*/

# Local crash reports and updater audit folders
ErrorReports/
.update-audit-*/

# Only the updater package and its manifest belong in the release folder.
/release/*
!/release/Shower-Programmer-Windows.zip
!/release/Shower-Programmer-Windows.json
/screenshots/
.venv/

# Workstation shortcuts, transient files, and private environment variables
*.lnk
*.log
*.part
.env
.env.*
!.env.example
/.codex/
/.agents/
